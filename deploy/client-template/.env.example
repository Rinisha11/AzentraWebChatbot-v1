APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=5000
PORT=5000
WEB_CONCURRENCY=2

OPENAI_API_KEY=your-openai-key
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

SITE_CONFIG_PATH=/app/client/sites.json
ALLOWED_ORIGINS=https://www.example-client.com,https://example-client.com
CHAT_LOG_PATH=/app/client/logs/chat_logs.jsonl

CHATBOT_BRAND=Example Client
CHATBOT_ASSISTANT_NAME=Support Assistant
CHATBOT_WELCOME_MESSAGE=Hi, how can I help you today?
SYSTEM_PROMPT_SUFFIX=

CHROMA_DIR=/app/client/chroma/default-site
DATA_DIR=/app/client/data/default-site
